# DGX Spark 의 vLLM 실행 값(추후 도입 — docs/08-추후-도입/01-DGX-Spark-도입.md). 이 파일을 같은 폴더에 vllm.env 로 복사해 값을 채운다.
#   cp vllm.env.example vllm.env && chmod 600 vllm.env
# vllm.env 는 키가 들어 있으므로 git 에 올리지 않고(.gitignore) 본인만 읽을 수 있게 둔다(chmod 600).

# 이 키를 아는 쪽만 모델을 부를 수 있다. 만들기:  openssl rand -hex 24
# 같은 값을 K3s 서버의 Secret(litellm-secret 의 VLLM_API_KEY)에 넣는다: bash scripts/k3s-server/create-secrets.sh --vllm
VLLM_API_KEY=

# Hugging Face 토큰. 공개 모델이면 비워 둬도 된다. 내려받기가 거부되면 https://huggingface.co/settings/tokens 에서 만든다.
HF_TOKEN=

# 서빙할 모델과 그 모델의 보조(초안) 모델. NVIDIA 가 DGX Spark 128GB 용으로 확인한 조합이다(2026-10-19 확인분).
# K3s 쪽 site.env 의 VLLM_MODEL 과 같아야 한다.
VLLM_MODEL=nvidia/Qwen3.8-27B-NVFP4
VLLM_DRAFT_MODEL=z-lab/Qwen3.8-27B-DFlash2

# vLLM 컨테이너 이미지 (NVIDIA 가 위 모델과 함께 확인한 버전)
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.10.pre1-py3

# 듣는 포트. 다른 프로그램이 8000 을 쓰고 있으면 8001 로 바꾸고 site.env 의 DGX_SPARK_PORT 도 같이 바꾼다.
VLLM_PORT=8000
