# 이 설치에만 해당하는 값 모음. 이 파일을 site.env 로 복사해 값을 고친 뒤 scripts/render.sh 를 실행하면
# k8s/ 의 매니페스트에 값이 채워져 rendered/ 에 만들어진다.
#   cp site.env.example site.env
# site.env 와 rendered/ 는 git 에 올리지 않는다(.gitignore). 비밀번호·키는 여기에 적지 않는다(scripts/k3s-server/create-secrets.sh).
# 값을 정하는 방법은 docs/00-개요/02-준비물과-정할-값.md 에 있다.

# ── 바깥에서 들어오는 주소 ──
# AI 서버의 도메인. 이 이름의 DNS 가 AI 서버(AWS EC2)의 탄력적 IP 를 가리켜야 한다.
AI_DOMAIN=ai.example.com
# Let's Encrypt 가 인증서 만료 안내를 보내는 메일 주소
ACME_EMAIL=you@example.com
# 인증서 발급처. 처음에는 연습용(letsencrypt-staging)으로 확인하고, 잘 되면 실제용(letsencrypt-prod)으로 바꾼다.
CLUSTER_ISSUER=letsencrypt-staging

# ── 접근을 허용할 공인 IP (CIDR 표기, IP 하나면 끝에 /32) ──
# 1: 딸기로 백엔드가 도는 서버의 공인 IP(탄력적 IP). 2: 확인용으로 열어 둘 IP(없으면 1과 같은 값).
# 같은 IP 를 AWS 보안 그룹의 443 규칙에도 넣는다 — 두 곳이 모두 허용해야 들어온다(docs/05-외부-공개).
ALLOW_IP_1=203.0.113.10/32
ALLOW_IP_2=203.0.113.10/32

# ── 대화 모델 (Claude API) ──
# 게이트웨이의 이름표가 가리킬 Claude 모델 ID. 바꾸면 docs/00-개요/02-준비물과-정할-값.md 의 버전 고정표도 함께 고친다.
# chat-fast : 감성 분류·조건 뽑기처럼 건수가 많고 단순한 일 → 빠르고 값싼 모델
# chat-smart: 브리핑·추천 사유처럼 글을 쓰는 일 → 더 좋은 모델
CHAT_FAST_MODEL=claude-haiku-5-5
CHAT_SMART_MODEL=claude-sonnet-5-5

# ── 컨테이너 이미지 ──
# 에이전트 이미지 이름:태그. scripts/build-and-load.sh 가 이 이름으로 빌드한다.
AGENT_IMAGE=ddalgiro/agent-api:0.4.0
# 임베딩 서버 이미지. AI 서버가 x86_64 인스턴스라서 cpu-1.9 를 쓴다.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9

# ── 별도 서버의 Langfuse ──
# 새 설치는 별도 Langfuse 서버를 기본으로 연결한다. 실제 HTTPS 도메인으로 바꾸고,
# 에이전트를 배포하기 전에 프로젝트 키를 쿠버네티스 Secret 에 넣는다. 키는 이 파일에 적지 않는다.
# 관측 서버에는 문의·근거·응답 원문을 보내지 않는다. docs/07-운영/02-모니터링과-AI-추적.md 참고.
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=https://langfuse.example.com

# ── (추후 도입) DGX Spark ──
# 대화 모델을 사무실의 DGX Spark 로 옮길 때만 아래 세 줄의 주석(#)을 풀고 값을 채운다
# (docs/08-추후-도입/01-DGX-Spark-도입.md). DGX_SPARK_IP 가 있으면 render.sh 가 k8s/dgx-spark/ 의 매니페스트도 함께 만든다.
# DGX_SPARK_IP: AI 서버에서 DGX Spark 로 닿는 주소(둘을 이은 사설 연결 위의 IP).  VLLM_MODEL: vllm.env 의 VLLM_MODEL 과 같은 값.
# DGX_SPARK_IP=192.168.0.20
# DGX_SPARK_PORT=8000
# VLLM_MODEL=nvidia/Qwen3.8-27B-NVFP4
